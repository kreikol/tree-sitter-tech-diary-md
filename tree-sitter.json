{
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "authors": [
      {
        "name": "Miriam Ruiz"
      }
    ],
    "description": "Tech Diary Markdown grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/kreikol/tree-sitter-tech-diary-md"
    }
  },
  "grammars": [
    {
      "name": "tech_diary_md_blocks",
      "camelcase": "TechDiaryMarkdownBlocks",
      "scope": "text.tech_diary_md_blocks",
      "path": "tree-sitter-tech-diary-md",
      "injection-regex": "^(markdown|md)$",
      "file-types": [
        "md", "tech_diary"
      ],
      "highlights": "tree-sitter-tech-diary-md-blocks/queries/highlights.scm",
      "injections": "tree-sitter-tech-diary-md-blocks/queries/injections.scm",
      "external-files": [
        "common/common.js"
      ]
    },
    {
      "name": "tech_diary_md_inline",
      "camelcase": "TechDiaryMarkdownInline",
      "scope": "text.tech_diary_md_inline",
      "path": "tree-sitter-tech-diary-md-inline",
      "highlights": "tree-sitter-tech-diary-md-inline/queries/highlights.scm",
      "injections": "tree-sitter-tech-diary-md-inline/queries/injections.scm",
      "external-files": [
        "common/common.js"
      ]
    }
  ]
}
